# Copy to .env.local for development. On the server this is .env at mode 600.
# Never commit a filled copy.

# --- Database ---------------------------------------------------------------
# Dev points at docker-compose.dev.yml. Production binds Postgres to localhost.
DATABASE_URL=
# Separate database on the same instance. Dropped and recreated by `npm run test`.
TEST_DATABASE_URL=

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 32
# Rotating this logs everyone out. Do it once before launch, not after.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in. Redirect URI needs the real domain, so this stays empty
# until O1 (domain purchase) closes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Storage ----------------------------------------------------------------
# Outside the web root, always. Never anywhere under public/.
# Production: /var/lib/tp
STORAGE_ROOT=

# --- Business -----------------------------------------------------------
# The Baridimob RIP number lives in `app_settings` now (admin → Settings),
# not here. These two are vestigial and unread by the app.
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_INSTAGRAM=trendyplaza_architecture

# --- Notifications ------------------------------------------------------
# One outbound email in the whole app: the client is told a new order, a new
# contact message, or a new receipt is waiting, via Web3Forms (web3forms.com)
# — no SMTP, no account with this app, delivers to whatever inbox is
# configured against this key on Web3Forms' own dashboard.
#
# NEXT_PUBLIC_ on purpose: Web3Forms' free plan refuses server-to-server
# calls outright (confirmed against the real key — a paid plan plus a
# server-IP allowlist is required for that). The send has to happen from the
# browser, via src/lib/notify-client.ts, so the key has to ship in the
# client bundle. This is how Web3Forms expects to be used; the key can only
# ever trigger one fixed email, nothing else.
#
# Left empty here, every notification silently no-ops rather than failing
# the order/message/receipt it was attached to. See _BUILD/DEPLOY_SECRETS.md
# for the real key.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
