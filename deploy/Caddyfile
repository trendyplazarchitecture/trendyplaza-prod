# Caddy is the only container with a public port. It terminates TLS, issues
# and renews the certificate on its own, and proxies everything to `web`.
#
# {$DOMAIN} and {$ACME_EMAIL} come from the environment, which comes from
# `.env`. Nothing here is hard-coded to a domain, because the domain is not
# bought yet (open item O1) and a hostname baked into a config file is a
# hostname somebody forgets to change.

{
	email {$ACME_EMAIL}
	# Caddy writes its own access log; the application logs to stdout and
	# Docker keeps that. Two copies of the same request is disk on a small box.
	servers {
		trusted_proxies static private_ranges
	}
}

# The apex, and www folded into it. One canonical host, so a session cookie
# and an OAuth redirect URI have exactly one origin to agree about.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	header {
		# HSTS. Two years, subdomains included. Do not enable preload until the
		# domain is settled: getting off the preload list takes months.
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Caddy announces itself by default. It does not need to.
		-Server
	}

	# Next's build output is content-hashed, so it can be cached hard. Nothing
	# else on this site may be: every page that matters is per-student.
	@immutable path /_next/static/* /favicon/* /products/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# The health endpoint is for Docker and for this proxy. It is not something
	# to expose to the internet, where it is a free liveness oracle.
	@health path /api/health
	respond @health 404

	reverse_proxy web:3000 {
		# The application reads the client address for its rate limiter, taking
		# the first entry of `x-forwarded-for` and falling back to `x-real-ip`.
		#
		# Both are *overwritten* rather than appended to. Caddy appends by
		# default, which leaves anything the client sent sitting in front of the
		# real address in the list — so a visitor could pick their own rate-limit
		# bucket and get a fresh allowance per request. Overwriting is what makes
		# `clientIp()` trustworthy, and it is only trustworthy because this proxy
		# is the only way in.
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}

		health_uri /api/health
		health_interval 30s
		health_timeout 5s
	}

	# A 200 MB resource upload from the admin, and a phone photo of a receipt
	# from a student. The default would refuse both.
	request_body {
		max_size 200MB
	}
}
