# Copy to `.env` on the server, next to docker-compose.prod.yml, mode 600.
# Never commit a filled copy. `npm run check:invariants` fails if one appears.
#
#   cp .env.production.example .env && chmod 600 .env && nano .env
#
# Compose reads this file for `${...}` substitution *and* hands it to the
# containers through `env_file`. One file, one source of truth.

# --- The domain -------------------------------------------------------------
# Open item O1. Caddy issues the certificate for exactly this name, and the
# www host redirects to it. No scheme, no trailing slash.
DOMAIN=example.com
# Where Let's Encrypt sends expiry warnings. A real inbox someone reads.
ACME_EMAIL=

# --- Database ---------------------------------------------------------------
# The container is not published to the host, so `db` is reachable only from
# the compose network. Generate the password: openssl rand -base64 24
POSTGRES_USER=tp
POSTGRES_PASSWORD=
POSTGRES_DB=tp
# Host is the service name. Not localhost: that is the web container itself.
DATABASE_URL=postgres://tp:CHANGE_ME@db:5432/tp

# --- Auth -------------------------------------------------------------------
# openssl rand -base64 32
# Rotating this signs everyone out. Do it once before launch, never after.
BETTER_AUTH_SECRET=
# Must be the public origin, with https. Better Auth builds callback URLs from
# it, and a mismatch fails sign-in with an error that names nothing useful.
BETTER_AUTH_URL=https://example.com

# Google sign-in. The redirect URI in the Google console is
# https://<domain>/api/auth/callback/google. Blocked on O1.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Storage ----------------------------------------------------------------
# Inside the container, on the `tp_storage` volume. Outside the web root by
# construction: there is no path under public/ that reaches it.
STORAGE_ROOT=/var/lib/tp

# --- Business, inlined at BUILD time ----------------------------------------
# Next inlines every NEXT_PUBLIC_ value into the bundle when the image is
# built. Changing one of these needs `up -d --build`, not a restart. The RIP
# number used to live here too; it is in `app_settings` now (admin → Settings),
# edited live with no rebuild. Both of these are vestigial and unread by the
# app — Instagram and the phone/WhatsApp number both come from `app_settings`
# instead — kept only because nothing has removed them from the Dockerfile yet.
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_INSTAGRAM=trendyplaza_architecture
